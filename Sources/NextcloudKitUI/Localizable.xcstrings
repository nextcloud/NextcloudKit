        "et_EE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seda linki saad muuta kergesti meeldejäetavaks, aga palun ära muuda selliseks, mis oleks liiga lihtne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien peut être changé pour être plus simple à retenir, mais ne le définissez pas sur quelque chose de facile à deviner."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir an nasc a athrú ionas go mbeidh sé éasca a mheabhrú, ach ná socraigh é ar rud éigin atá éasca a thomhas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link può essere modificato per renderlo facile da ricordare, ma non impostarlo su qualcosa di facile da indovinare."
          }
        },
        "pt_BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O link pode ser alterado para ficar fácil de lembrar, mas não o defina como algo que seja fácil de adivinhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылку можно изменить так, чтобы её было легко запомнить, но не стоит выбирать название, которое легко угадать."
          }
        },
        "sk_SK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz je možné zmeniť tak, aby sa dal ľahko zapamätať, ale nenastavujte ho na niečo, čo sa dá ľahko uhádnuť."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı hatırlanması kolay olacak şekilde değiştirilebilir. Ancak kolay bulunabilecek bir şeye ayarlamayın."
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以將連結改為容易記住的內容，但請勿設為容易猜到的內容。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以將連結改為容易記住的內容，但請勿設為容易猜到的內容。"
          }
        }
      }
    },
    "This share is limited to \"%@\". You can only grant the same or fewer permissions." : {
      "comment" : "Explains that recipient permissions cannot exceed the share-wide preset; the placeholder is the preset name.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
