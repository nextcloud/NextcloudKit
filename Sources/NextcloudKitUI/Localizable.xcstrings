        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The link can be changed to be easy to remember, but do not set it to something that is easy to guess."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace puede ser cambiado para ser fácil de recordar, pero no lo cambies a algo que sea fácil de adivinar."
