    "This change will replace the individual permission settings of all recipients in this share." : {
      "comment" : "Explanation shown before propagating top-level permission changes to every recipient.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne ændring erstatter de individuelle rettigheder for alle modtagere af denne deling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Änderung ersetzt die individuellen Berechtigungseinstellungen aller Empfänger dieser Freigabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This change will replace the individual permission settings of all recipients in this share."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This change will replace the individual permission settings of all recipients in this share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio reemplazará los ajustes de permisos individuales de todos los destinatarios de este recurso compartido."
          }
        },
        "et_EE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle muudatusega asendad kõikide jagamise saajate isiklikud õigused üldiste õigustega."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette modification remplacera les paramètres des autorisations individuelles de tous les destinataires de ce partage."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuirfidh an t-athrú seo ionad na socruithe ceada aonair do gach faighteoir sa scair seo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modifica sostituirà le impostazioni di autorizzazione individuali di tutti i destinatari di questa condivisione."
          }
        },
        "pt_BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa alteração substituirá as configurações de permissão individuais de todos os destinatários deste compartilhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это изменение заменит индивидуальные настройки прав доступа всех получателей в этом общем ресурсе."
          }
        },
        "sk_SK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto zmena nahradí individuálne nastavenia oprávnení všetkých príjemcov v tomto zdieľaní."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değişiklik, bu paylaşımdaki tüm alıcıların bireysel izin ayarlarının yerini alacak."
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此變更會取代此分享中所有接收者的個別權限設定。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此變更會取代此分享中所有收件人的個別權限設定。"
          }
        }
      }
    },
