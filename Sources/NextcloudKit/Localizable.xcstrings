          "stringUnit" : {
            "state" : "translated",
            "value" : "A secure connection to the server couldn't be established."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A secure connection to the server couldn't be established."
          }
        },
