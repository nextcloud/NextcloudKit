{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is a forbidden name." : {
      "comment" : "Error message when the server reserves a name. %@ is the name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is a forbidden name."
          }
        }
      }
    },
