      "comment" : "Error message when the server forbids a file extension. %@ is the extension.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\".%@\" is a forbidden file extension."
          }
        }
      }
    },
    "A file or folder with this name already exists." : {
      "comment" : "Error message when a file or folder with the same name already exists.",
