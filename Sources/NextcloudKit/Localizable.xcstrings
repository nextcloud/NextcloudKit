    "A secure connection to the server couldn't be established." : {
      "comment" : "Error message for TLS and certificate failures.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kunne ikke oprettes en sikker forbindelse til serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine sichere Verbindung zum Server konnte nicht hergestellt werden."
